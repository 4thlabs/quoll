@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# quoll::asio (and quoll::runtime, natively, through it) links Threads::Threads: only looked for when it may be used.
if(NOT quoll_FIND_COMPONENTS OR "asio" IN_LIST quoll_FIND_COMPONENTS
   OR ("runtime" IN_LIST quoll_FIND_COMPONENTS AND NOT EMSCRIPTEN))
  find_dependency(Threads)
endif()

# quoll::asio (and quoll::runtime, through it) links OpenSSL when Quoll was configured with it (QUOLL_TLS).
if("@QUOLL_PACKAGE_NEEDS_OPENSSL@" AND (NOT quoll_FIND_COMPONENTS OR "asio" IN_LIST quoll_FIND_COMPONENTS
   OR "runtime" IN_LIST quoll_FIND_COMPONENTS))
  find_dependency(OpenSSL)
endif()

# quoll::rest and quoll::ui link glaze::glaze: the application defines it before (CPM, add_subdirectory), or it is found
# here. Only required when one of them is asked for by name; otherwise looked for quietly, and needed only by a target linking one of them.
if(NOT TARGET glaze::glaze)
  # Under Emscripten, quoll::runtime brings quoll::ui, through quoll::emscripten.
  if("rest" IN_LIST quoll_FIND_COMPONENTS OR "ui" IN_LIST quoll_FIND_COMPONENTS
     OR ("runtime" IN_LIST quoll_FIND_COMPONENTS AND EMSCRIPTEN))
    find_dependency(glaze)
  elseif(NOT quoll_FIND_COMPONENTS)
    find_package(glaze QUIET)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/quoll-targets.cmake")

foreach(quoll_module IN ITEMS @QUOLL_PACKAGE_MODULES@)
  set(quoll_${quoll_module}_FOUND TRUE)
endforeach()

check_required_components(quoll)
